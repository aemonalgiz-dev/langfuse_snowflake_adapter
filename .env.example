# For running locally. In a container, pass the keys as secrets instead (see
# docker-compose.yml): files under /run/secrets named langfuse_public_key,
# langfuse_secret_key, snowflake_private_key and sync_api_key.

# --- Langfuse -----------------------------------------------------------------
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
# JP: https://jp.cloud.langfuse.com   HIPAA: https://hipaa.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Several projects instead of one: name them, and give each its own key pair.
# Anything else a project does not set (host, API version) falls back to the
# unprefixed LANGFUSE_* value. The data team configures each one separately.
# LANGFUSE_PROJECTS=support,search
# LANGFUSE_SUPPORT_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SUPPORT_SECRET_KEY=sk-lf-...
# LANGFUSE_SEARCH_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SEARCH_SECRET_KEY=sk-lf-...

# v4 = Langfuse Cloud and self-hosted v4 (observations v2 + scores v3 endpoints).
# v3 = self-hosted v3 (legacy trace/observation/score/session endpoints).
LANGFUSE_API_VERSION=v4

# v4 only: observation field groups to request. Drop "io" to leave prompts and
# completions out of Snowflake. "basic" and "trace_context" are needed for the
# traces and sessions views.
# LANGFUSE_OBSERVATION_FIELDS=core,basic,time,io,metadata,model,usage,prompt,metrics,trace_context

# v4 only: metadata values over 200 characters are truncated unless the key is
# listed here.
# LANGFUSE_EXPAND_METADATA=key_one,key_two

# Rows per request. Defaults to each endpoint's maximum; lower it if large
# inputs/outputs cause timeouts.
# LANGFUSE_PAGE_SIZE=500
# LANGFUSE_TIMEOUT_SECONDS=60
# Extra attempts after a rate limit, server error or network failure.
# LANGFUSE_MAX_RETRIES=6

# --- Snowflake (key-pair auth) ------------------------------------------------
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=LANGFUSE_LOADER
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
# Alternatively pass the PEM itself (e.g. from a secret manager):
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=LANGFUSE_LOADER
SNOWFLAKE_WAREHOUSE=LOADING_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=LANGFUSE
# Extra attempts after a network or service error.
# SNOWFLAKE_MAX_RETRIES=2

# --- Sync ---------------------------------------------------------------------
# From here on these are defaults. The data team can change most of them in the
# web app, and what they save there wins over these values.

# The service starts a sync by itself this often, in minutes. 0 leaves it off.
# SYNC_SCHEDULE_MINUTES=60

# Where settings changed in the web app are kept. The container image sets
# /data/config.json; set it yourself when running outside a container.
# SYNC_CONFIG_FILE=./config.json

# The last three are read in full on every sync, since Langfuse cannot filter
# them by time. One your plan or version does not offer is skipped with a notice.
SYNC_ENTITIES=observations,scores,traces,sessions,comments,annotation_queues,annotation_queue_items
SYNC_TABLE_PREFIX=LANGFUSE_

# Share of traces to load, above 0 and up to 1. A trace is kept or dropped as a
# whole, by a hash of its ID, so the same traces are chosen on every run.
# SYNC_SAMPLE_RATE=0.1

# Only load matching records. Semicolon-separated, each [entity:]field<op>value
# with = != > >= < <= ~ (contains) !~. Field names are the API's (camelCase).
# SYNC_FILTERS=environment=production;observations:level!=DEBUG;scores:name=accuracy,toxicity

# Fields removed from every record before it is loaded, comma-separated, each
# [entity:]path with a dotted path for a key inside a nested field.
# SYNC_EXCLUDE_FIELDS=observations:input,observations:metadata.email

# Each incremental run re-reads this far behind the watermark. Keep it longer
# than your longest-running observation plus ingestion delay.
SYNC_LOOKBACK_MINUTES=180
# How far back the first run goes.
SYNC_INITIAL_BACKFILL_DAYS=30
# The watermark is checkpointed after each window.
SYNC_WINDOW_HOURS=24

# Reconciling keeps data that is already loaded in step with Langfuse: scores
# edited by a reviewer, records that surfaced late, records deleted since.
# A sync does it by itself once this many hours have passed; 0 turns that off.
SYNC_RECONCILE_EVERY_HOURS=24
# How far back it looks. Edits to older records are not picked up.
SYNC_RECONCILE_DAYS=30
# Compare observations by content instead of by ID and updatedAt. Thorough,
# but downloads every observation in the window each time.
# SYNC_RECONCILE_FULL=true
# Rows whose record was deleted in Langfuse are counted and logged, never
# removed. With a filter active that takes an extra, unfiltered listing of IDs;
# set this to false to skip the check.
# SYNC_CHECK_DELETIONS=false

# --- Web app and HTTP API -----------------------------------------------------
# The container overrides host and port; these apply when running locally.
SYNC_API_HOST=127.0.0.1
SYNC_API_PORT=8000
# Required to listen on anything other than loopback, so always in a container.
# The data team enters it in the web app. Use a long random value.
# SYNC_API_KEY=
